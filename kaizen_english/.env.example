# Скопируйте в .env и заполните. Файл .env НЕ коммитьте в git.
BOT_TOKEN=put-your-token-from-BotFather-here

# Путь к файлу SQLite. В облаке укажите путь на ПОСТОЯННОМ диске (volume), например /data/kaizen.db
KAIZEN_DB_PATH=data/kaizen.db

# Часовой пояс, по которому считаются "сегодня" и время напоминаний
KAIZEN_TIMEZONE=Europe/Moscow

# Необязательно
KAIZEN_LOG_LEVEL=INFO
